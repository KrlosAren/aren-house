# ===========================================
# dnsmasq - DHCP + TFTP para homelab
# Managed by Ansible - Do not edit manually
# ===========================================

# Interfaces - escuchar en LAN, WAN y Tailscale (solo DNS en WAN y Tailscale, DHCP solo en LAN)
interface={{ dnsmasq_interface }}
interface={{ dnsmasq_wan_interface }}
interface=tailscale0
listen-address=127.0.0.1
bind-dynamic
no-dhcp-interface={{ dnsmasq_wan_interface }}
no-dhcp-interface=tailscale0

# No usar /etc/resolv.conf del sistema
no-resolv

# DNS upstream
{% for server in dnsmasq_dns_servers %}
server={{ server }}
{% endfor %}

# Dominio local
domain={{ dnsmasq_domain }}
local=/{{ dnsmasq_domain }}/
address=/.{{ dnsmasq_domain }}/{{ dnsmasq_network.gateway }}
address=/.k8s.{{ dnsmasq_domain }}/{{ dnsmasq_network.wan_ip }}

# ----- DHCP -----
dhcp-range={{ dnsmasq_network.range_start }},{{ dnsmasq_network.range_end }},{{ dnsmasq_network.lease_time }}
dhcp-option=option:router,{{ dnsmasq_network.gateway }}
dhcp-option=option:dns-server,{{ dnsmasq_network.gateway }}

# ----- host record -----
host-record={{ dnsmasq_network.dns }},{{ dnsmasq_network.dns }}.{{ dnsmasq_domain }},{{ dnsmasq_network.gateway }}


# IPs fijas por MAC
{% for host in dnsmasq_hosts %}
dhcp-host={{ host.mac }},{{ host.name }},{{ host.ip }},infinite
{% endfor %}



# ----- Logging -----
{% if dnsmasq_log_queries %}
log-queries
{% endif %}
{% if dnsmasq_log_dhcp %}
log-dhcp
{% endif %}
log-facility={{ dnsmasq_log_file }}
