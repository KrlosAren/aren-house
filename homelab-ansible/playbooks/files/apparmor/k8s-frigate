# AppArmor para el contenedor de Frigate (k8s-apps/frigate/03-frigate-deployment.yml).
# Gestionado por homelab-ansible/playbooks/apparmor.yml — no editar en el nodo.
#
# Copia del perfil por defecto de containerd (cri-containerd.apparmor.d, contrib/apparmor/template.go)
# con UN cambio: las reglas signal/ptrace entre procesos del contenedor también aceptan la
# etiqueta apilada "<perfil>//&unconfined".
#
# Por qué: en Ubuntu 26.04 (AppArmor 5) los procesos del contenedor quedan con la etiqueta
# "cri-containerd.apparmor.d//&unconfined". El perfil de containerd solo permite
# peer=cri-containerd.apparmor.d → el contenedor no puede enviarse señales a sí mismo:
# Frigate no puede matar su ffmpeg colgado (os.kill → PermissionError) y la cámara queda
# "offline" tras un corte. En las Pi (Ubuntu 25.10) no ocurre.

#include <tunables/global>

profile k8s-frigate flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # Procesos del host (kubelet/containerd/runc) pueden enviar señales al contenedor
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,

  # Procesos del contenedor pueden enviarse señales entre sí (con y sin etiqueta apilada)
  signal (send,receive) peer=k8s-frigate,
  signal (send,receive) peer="k8s-frigate//&unconfined",

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Procesos del contenedor pueden inspeccionarse entre sí (psutil de Frigate lee /proc de ffmpeg)
  ptrace (trace,tracedby,read,readby) peer=k8s-frigate,
  ptrace (trace,tracedby,read,readby) peer="k8s-frigate//&unconfined",
}
